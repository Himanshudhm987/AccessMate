# AccessMate Environment Configuration Template
# DO NOT store real production secrets in this file. Copy this file to .env and configure.

# Server Port (Default: 5000)
PORT=5000

# Client Web Application Origin for CORS and CSRF verification
# In local development: http://localhost:5173
# In production: https://yourdomain.com
CLIENT_ORIGIN=http://localhost:5173

# Secret Key for JWT sessions (Minimum 32 characters required in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_strong_random_secret_at_least_32_characters_long

# Node Environment: 'development' | 'production' | 'test'
NODE_ENV=development

# Optional Reverse Proxy Trust Setting (e.g., '1' for NGINX / Cloudflare, 'false' for direct)
TRUST_PROXY=false
